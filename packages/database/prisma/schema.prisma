generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────

enum NutrientType {
  PROTEINA
  CARBOIDRATO
  FIBRA
  GORDURA
}

enum SpecialRequestStatus {
  PENDING
  FULFILLED
}

enum PlanoOrigem {
  PROFISSIONAL_SAUDE
  EXPERIENCIA_CHEF
}

enum MealPrepLocal {
  CASA_CLIENTE
  COZINHA_CHEF
}

enum MealPrepStatus {
  AGENDADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

// ── Models ──────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cliente {
  id                         String   @id @default(uuid())
  name                       String
  phone                      String   @unique
  email                      String?
  address                    String?
  street                     String?
  number                     String?
  neighborhood               String?
  city                       String?
  zipCode                    String?
  instagram                  String?
  whatsapp                   String?
  dietaryRestrictions        String?
  preferences                String?
  healthProfessionalName     String?
  healthProfessionalSpecialty String?
  lgpdConsent                Boolean  @default(false)
  tags                       String[] @default([])
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  planosAlimentares PlanoAlimentar[]
  specialRequests   SpecialRequest[]
  mealPrepSessions  MealPrepSession[]
}

model MenuItem {
  id           String      @id @default(uuid())
  name         String
  description  String?
  nutrientType NutrientType
  photoUrl     String?
  allergens    String?
  baseUnit     String      @default("porção")
  available    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  technicalSheet TechnicalSheet?
}

model TechnicalSheet {
  id                String   @id @default(uuid())
  menuItemId        String   @unique
  preparationMethod String
  cookingTime       Int      // minutos
  temperature       String?  // ex: "200°C"
  equipment         String[]
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model PlanoAlimentar {
  id                          String      @id @default(uuid())
  clienteId                   String
  origem                      PlanoOrigem @default(EXPERIENCIA_CHEF)
  description                 String      @default("")
  period                      String?
  healthProfessionalName      String?
  healthProfessionalSpecialty String?
  notes                       String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  cliente          Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mealPrepSessions MealPrepSession[]
}

model MealPrepSession {
  id             String         @id @default(uuid())
  clienteId      String
  mealPlanId     String
  date           DateTime
  location       MealPrepLocal
  mealCount      Int?
  durationHours  Int?
  status         MealPrepStatus @default(AGENDADO)
  groceryService Boolean        @default(false)
  totalValue     Float
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cliente  Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mealPlan PlanoAlimentar @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
}

// ── Preços centralizados (não hardcoded) ──
// ponytail: Float por consistência com o legado (valores inteiros em R$).
// Trocar por Decimal se surgirem centavos em escala.
model PricingConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Float
  description String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model SpecialRequest {
  id           String               @id @default(uuid())
  clienteId    String?
  description  String
  nutrientType NutrientType?
  status       SpecialRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id])
}
